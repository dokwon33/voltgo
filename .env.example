# OpenAI (실습 .env 와 같은 키 이름)
OPENAI_API_KEY=
MODEL_NAME=gpt-4.1-mini

# TMAP (SK open API) - 비워두면 data/mock 의 장소/경로 fixture 를 쓴다
TMAP_APP_KEY=

# TMAP JavaScript 지도 - 웹 서버가 브라우저에 전달하는 공개용 앱 키
# 해당 앱에서 Raster Map 사용 권한을 확인한 뒤 설정한다.
TMAP_MAP_APP_KEY=

# 현대자동차 Developers API - OAuth 는 README 절차대로 브라우저에서 받아 넣는다
HYUNDAI_ACCESS_TOKEN=
HYUNDAI_CAR_ID=

# 현대차 API 대신 Mock 데이터 사용 여부 (기본 true)
USE_MOCK_CHARGING=true
MOCK_CHARGING_FIXTURE=charging_ok

# CLI 시연용 사용자 ID. 웹은 이 값을 사용하지 않고 브라우저 세션으로 구분한다.
VOLTGO_USER_ID=user_001

# HTTPS 뒤에 웹 데모를 실행할 때 true. 로컬 HTTP 데모는 false.
VOLTGO_COOKIE_SECURE=false
